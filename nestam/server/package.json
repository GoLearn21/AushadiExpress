{
  "name": "nestam-server",
  "version": "0.1.0",
  "private": true,
  "description": "Nestam (నేస్తం) — Telugu AI companion backend built on Sarvam AI APIs (Saaras STT, Bulbul TTS, Sarvam-105B chat, Mayura translate).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "NESTAM_ENV=development tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && cp -r public dist/public",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.25.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
