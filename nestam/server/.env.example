# ── Sarvam AI ─────────────────────────────────────────────────────────────────
# Get a key at https://dashboard.sarvam.ai (new accounts get free credits).
# Leave EMPTY to run in MOCK mode: the whole voice loop works offline with
# canned Telugu replies and synthesized "bomma-speak" audio — no credits used.
SARVAM_API_KEY=

# Model choices (verified against sarvamai SDK 1.1.9, Aug 2026)
SARVAM_STT_MODEL=saaras:v3            # or saaras:v4
SARVAM_TTS_MODEL=bulbul:v3            # bulbul:v2 also supported (pitch/loudness)
SARVAM_CHAT_MODEL=sarvam-105b         # or sarvam-105b-conversations
SARVAM_TRANSLATE_MODEL=mayura:v1      # or sarvam-translate:v1
SARVAM_REASONING_EFFORT=low           # low | medium | high (low = fastest replies)
SARVAM_TTS_SAMPLE_RATE=22050          # 8000 | 16000 | 22050 | 24000 (REST also 32000/44100/48000)

# ── Free-tier budget guard (₹) ────────────────────────────────────────────────
# The server estimates spend per call and switches to "thrifty mode"
# (text-only replies, cached greetings) once the daily cap is reached
# instead of failing. Defaults fit inside the ₹1,000 signup credit.
NESTAM_DAILY_BUDGET_INR=30
NESTAM_RATE_STT_INR_PER_HOUR=30
NESTAM_RATE_TTS_INR_PER_HOUR=30
NESTAM_RATE_LLM_INR_PER_M_INPUT=29.28
NESTAM_RATE_LLM_INR_PER_M_OUTPUT=73.2

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4020
NESTAM_DATA_DIR=./data                # JSON store + TTS cache (persist this on Railway)
NESTAM_CORS_ORIGIN=*                  # tighten in production
NESTAM_LOG_LEVEL=info
